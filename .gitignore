# 環境変数ファイル（セキュリティ上重要）
.env
src/.env
*.env

# ログファイル
*.log
src/debug.log

# 一時ファイル・アップロードファイル
tmp/
temp/
src/temp_uploads/*
!src/temp_uploads/.gitkeep
# 動画・サムネイルの期限付き専用 URL（media.php が自動生成）
src/media/

# アップロードされたファイル
src/videos/*
src/thumbnails/*
!src/videos/.gitkeep
!src/thumbnails/.gitkeep

# データファイル（ユーザー生成コンテンツ）
src/data/*
!src/data/.gitkeep

# IDE設定
.vscode/
.idea/
*.swp
*.swo

# OS生成ファイル
.DS_Store
Thumbs.db

# Docker関連
.dockerignore

# セッションファイル
sessions/

# キャッシュファイル
*.cache

# デプロイ先の設定（サーバーのパス・ドメインを含むため）
deploy/instances.conf
