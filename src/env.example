# MyTube 環境設定テンプレート
# このファイルを .env にコピーして使用してください

# サイト/ブランド名
APP_NAME=MyTube

# 管理者パスワード（必須。未設定のままだと管理者としてログインできません）
# 8文字以上を推奨。以前の既定値 admin123 は使えません
ADMIN_PASSWORD=

# デバッグモード（本番環境では false に設定）
DEBUG_MODE=false

# セッション/クッキー設定（秒）
ADMIN_SESSION_LIFETIME=86400
REMEMBER_ME_LIFETIME=2592000
REMEMBER_ME_COOKIE_NAME=MyTube_remember

# アップロード設定（5GB）
UPLOAD_MAX_SIZE=5368709120
CHUNK_SIZE=2097152

# FFmpeg設定
FFMPEG_PATH=/usr/bin/ffmpeg

# 動画変換設定
CONVERT_TO_MP4=true
VIDEO_CODEC=libx264
VIDEO_PRESET=ultrafast
VIDEO_CRF=28
AUDIO_CODEC=aac
AUDIO_BITRATE=96k
WEB_OPTIMIZE=true 