# MyTube .htaccess 設定

# 機密ファイル・実行時データへの直接アクセスを禁止
# FilesMatch はファイル名にしか一致せず（data/ のようなパスは判定不可）、
# Xserver では Require all denied も効かないため、mod_rewrite で拒否する
<IfModule mod_rewrite.c>
    RewriteEngine On
    # ドットファイル（.env, .htaccess 等）。SSL証明書の検証用 .well-known は除く
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    # ログ・設定ファイル
    RewriteRule \.(env|ini|log|lock)$ - [F,L]
    # data/ 配下（設定・パスワード・復旧端末情報）。ロゴ画像のみ公開
    RewriteCond %{REQUEST_URI} !/data/branding/[^/]+\.png$
    RewriteRule ^data/ - [F,L]
    # 動画メタデータ（共有パスワードを含む）と変換中の進捗・状態ファイル
    RewriteRule ^videos/.+\.(json|txt)$ - [F,L]
    # アップロード途中のチャンク
    RewriteRule ^temp_uploads/ - [F,L]
    # 動画・サムネイルは閲覧権限を確認してから、期限付きの専用 URL へリダイレクトする（media.php）
    RewriteRule ^(videos|thumbnails)/([^/]+)$ media.php?kind=$1&name=$2 [B,QSA,L]
    # 専用 URL（media/<期間>/<トークン>/<ファイル名>）の形式以外は拒否（一覧表示等を防ぐ）。拡張子は大文字も可（.MOV 等）
    RewriteRule ^media/(?![0-9]+/[0-9a-f]{32}/[A-Za-z0-9][A-Za-z0-9._-]*\.(?i:mp4|webm|ogg|avi|mov|mkv|flv|jpg)$) - [F,L]
</IfModule>

# セキュリティヘッダー
<IfModule mod_headers.c>
    # XSS保護
    Header always set X-XSS-Protection "1; mode=block"
    # クリックジャッキング保護
    Header always set X-Frame-Options "SAMEORIGIN"
    # MIMEタイプスニッフィング保護
    Header always set X-Content-Type-Options "nosniff"
    # リファラーポリシー
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 静的アセットのキャッシュ制御
<IfModule mod_expires.c>
    ExpiresActive On
    
    # CSSファイル（1週間）
    ExpiresByType text/css "access plus 1 week"
    
    # JavaScriptファイル（1週間）
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    
    # 画像ファイル（1ヶ月）
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    
    # ファビコン（1年）
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
    
    # フォントファイル（1年）
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # media.php（動画・サムネイルの権限確認）はキャッシュをスクリプト側で制御する
    <Files "media.php">
        ExpiresActive Off
    </Files>
</IfModule>

# キャッシュヘッダーの設定
<IfModule mod_headers.c>
    # CSSファイル
    <FilesMatch "\.css$">
        Header set Cache-Control "public, max-age=604800"
        Header append Vary Accept-Encoding
    </FilesMatch>
    
    # JavaScriptファイル
    <FilesMatch "\.js$">
        Header set Cache-Control "public, max-age=604800"
        Header append Vary Accept-Encoding
    </FilesMatch>
    
    # 画像ファイル
    <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    
    # ファビコン
    <FilesMatch "favicon\.(ico|png|svg)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
</IfModule>

# 圧縮設定
<IfModule mod_deflate.c>
    # 有効にするファイルタイプ
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE text/javascript
</IfModule>

# セキュリティ設定
# PHPファイルへの直接アクセスを制限
<Files "*.php">
    # 管理ページ以外は直接アクセスを許可
    <RequireAll>
        Require all granted
    </RequireAll>
</Files>

# 設定ファイルへのアクセスを禁止（mod_rewrite が無い環境向けの予備）
<FilesMatch "\.(env|ini|log|lock)$">
  Require all denied
</FilesMatch>

# ディレクトリ一覧表示を無効化
Options -Indexes

# エラーページの設定
ErrorDocument 404 /index.php
ErrorDocument 403 /index.php 